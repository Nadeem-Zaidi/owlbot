# Copy to .env and fill in. Only the first block is required.

# ── Required ─────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=testerp
POSTGRES_USERNAME=postgres
POSTGRES_PASSWORD=

AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Needed for embeddings (RAG) even if you only chat with Claude.
OPENAI_API_KEY=

# gRPC service that converts uploaded files to Markdown.
GRPC_SERVER_ADDRESS=localhost:50051

# ── Chat models ──────────────────────────────────────────
# Any provider with a key shows up in the UI's model picker.
ANTHROPIC_API_KEY=
LLM_PROVIDER=openai                 # default provider: openai | anthropic

OPENAI_MODEL=gpt-4o-mini
OPENAI_MODELS=                      # extra models, comma-separated
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.7

ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_MODELS=claude-opus-5-5,claude-sonnet-5-5,claude-haiku-4-5
ANTHROPIC_MAX_TOKENS=64000
ANTHROPIC_EFFORT=medium             # low | medium | high | xhigh | max ("" to omit)
ANTHROPIC_ENABLE_FALLBACKS=true     # set false on Bedrock / Vertex / Foundry

# Provider agents (Agents → Provider agents). Models offered when creating
# an agent in Claude Managed Agents / the OpenAI Agents API (beta).
ANTHROPIC_NATIVE_AGENT_MODELS=claude-opus-5-5,claude-sonnet-5-5,claude-haiku-4-5
OPENAI_NATIVE_AGENT_MODELS=gpt-6-astra

# How much chat history is sent per request (all of it stays stored).
LLM_HISTORY_MAX_MESSAGES=60
LLM_HISTORY_MAX_CHARS=400000

# Max characters of a document sent by "Explain this document".
DOC_EXPLAIN_MAX_CHARS=120000

# OpenAI-only extras
ENABLE_CODE_INTERPRETER=true
CODE_INTERPRETER_MEMORY=
ENABLE_DEEPWIKI_MCP=false

# ── WhatsApp (optional) ──────────────────────────────────
WHATSAPP_ENABLED=false
WHATSAPP_SELF_CHAT=false            # true if the bot runs on your own number
WHATSAPP_ADMIN_EMAILS=              # who may pair the bot; empty = any signed-in user
WHATSAPP_AUTH_DIR=./auth_state
WEB_APP_URL=http://localhost:5173

# ── Agents (optional) ────────────────────────────────────
AGENT_SECRETS_KEY=                  # encrypts API keys saved on agents; auto-created in .agent_secrets_key if empty
AGENT_ALLOW_PRIVATE_URLS=false      # true lets agent functions/MCP call localhost (local development only)
OWNER_EMAILS=                       # your login email(s): turns on Python code functions (owner only)

# ── Misc ─────────────────────────────────────────────────
PORT=3000
LOG_LEVEL=info

# ── Billing (Razorpay subscriptions + monthly token quotas) ──────────────
# Keys from dashboard.razorpay.com → Settings → API Keys (use rzp_test_ keys first).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Dashboard → Settings → Webhooks: URL https://<your-api>/api/billing/webhook,
# events: subscription.* and payment.failed; paste the secret you chose here.
RAZORPAY_WEBHOOK_SECRET=
# Filled in by `npm run billing:create-plans`.
RAZORPAY_PLAN_PRO_MONTHLY=
RAZORPAY_PLAN_PRO_YEARLY=
RAZORPAY_PLAN_BUSINESS_MONTHLY=
RAZORPAY_PLAN_BUSINESS_YEARLY=
# Enforce the monthly token quotas (off until you're ready).
BILLING_ENABLED=false
# Never limited (defaults to OWNER_EMAILS).
BILLING_EXEMPT_EMAILS=
# Optional overrides — tokens per month and prices in paise (₹1 = 100).
# BILLING_FREE_TOKENS=100000
# BILLING_PRO_TOKENS=2000000
# BILLING_BUSINESS_TOKENS=10000000
# BILLING_PRO_MONTHLY_PAISE=49900
# BILLING_PRO_YEARLY_PAISE=499000
# BILLING_BUSINESS_MONTHLY_PAISE=199900
# BILLING_BUSINESS_YEARLY_PAISE=1999000

# Require a verified phone number for API access (matches the sign-up flow).
REQUIRE_VERIFIED_PHONE=true

# ── Production / scaling ───────────────────────────────────────────────
NODE_ENV=development                 # "production" on servers
PORT=3000
# Web app origin(s) allowed to call the API, comma-separated (required in production).
CORS_ORIGINS=http://localhost:5173
# Shared state across processes/servers (rate limits, browser approvals).
REDIS_URL=                           # e.g. redis://localhost:6379
# Per user per minute: all API calls / model calls.
RATE_LIMIT_PER_MINUTE=600
CHAT_RATE_LIMIT_PER_MINUTE=30
# Which proxies to trust for client IPs (behind a load balancer).
TRUST_PROXY=loopback, linklocal, uniquelocal
# Postgres connections per process (× processes must fit max_connections, or use PgBouncer).
PG_POOL_MAX=10
# node dist/cluster.js: processes per server (default: CPU count).
CLUSTER_WORKERS=
# Run the agent scheduler here (it's safe on several servers; set false to pin it).
SCHEDULER_ENABLED=true
SHUTDOWN_GRACE_MS=25000
# REQUIRED in production, identical on every server (decrypts saved agent secrets).
#   generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AGENT_SECRETS_KEY=
# Firebase Admin key as base64 (instead of serviceAccountKey.json on disk):
#   base64 -w0 serviceAccountKey.json
FIREBASE_SERVICE_ACCOUNT_BASE64=


# ── Knowledge base search ──
# Cosine-similarity floor: chunks below it are never returned (unrelated topics
# score ~0.1–0.2, on-topic ~0.4+). Raise to be stricter, lower if answers are missed.
KB_MIN_SCORE=0.3
# Also drop results more than this far below the best match.
KB_RELATIVE_MARGIN=0.2
# Chunk sizes in characters (re-run `npm run kb:reindex` after changing them).
KB_CHUNK_TARGET_CHARS=1000
KB_CHUNK_MAX_CHARS=1400
KB_CHUNK_MIN_CHARS=300
KB_CHUNK_OVERLAP_CHARS=150
