# Dependencies
node_modules/

# Build output
dist/
build/

# Environment / secrets
.env
.env.*
!.env.example

# WhatsApp/Baileys session — contains live session credentials (creds.json etc).
# Never commit this: anyone with it can act as your linked WhatsApp session.
auth_state/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Editor / OS
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
Thumbs.db

# Test/coverage artifacts
coverage/
*.tsbuildinfo

# Firebase Admin service-account key — a private credential, never commit it.
serviceAccountKey.json

# Encryption key for secrets saved on agents (auto-created if AGENT_SECRETS_KEY is unset)
.agent_secrets_key
