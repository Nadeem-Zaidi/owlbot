# Server settings for deploy/ec2. Copy to .env on the server and fill in:
#   cp .env.example .env && nano .env && chmod 600 .env
# Everything not listed here keeps the defaults from the main .env.example.

# ── Web address ──────────────────────────────────────────
# Your domain, pointed at the server's Elastic IP (an A record).
# No domain yet? Use <ip-with-dashes>.sslip.io, e.g. 13-233-10-20.sslip.io
# ":80" = plain HTTP for a first test only (phone sign-in needs HTTPS).
DOMAIN=owlbot.example.com
WEB_APP_URL=https://owlbot.example.com
CORS_ORIGINS=https://owlbot.example.com

# ── Database (runs on this server) ───────────────────────
POSTGRES_DATABASE=owlbot
POSTGRES_USERNAME=owlbot
# Generate: openssl rand -hex 24
POSTGRES_PASSWORD=

# ── Secrets (required) ───────────────────────────────────
# Firebase Admin key, base64 of serviceAccountKey.json:
#   base64 -w0 serviceAccountKey.json
FIREBASE_SERVICE_ACCOUNT_BASE64=
# Encrypts secrets saved on agents. Generate once, keep it safe, never change it:
#   openssl rand -hex 32
AGENT_SECRETS_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ── Files (S3) ───────────────────────────────────────────
AWS_REGION=ap-south-1
S3_BUCKET=nadeem-bucket-9891
# Leave both EMPTY on EC2 and attach an IAM role to the instance instead
# (README step 2). Keys here are only for servers outside AWS.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ── App ──────────────────────────────────────────────────
LLM_PROVIDER=openai
OPENAI_MODEL=gpt-4o-mini
OWNER_EMAILS=
REQUIRE_VERIFIED_PHONE=true

# WhatsApp: turn it on/off, self-chat mode and pairing admins in the web app
# (account menu → Server settings, owners only). These only seed the first value.
WHATSAPP_ENABLED=false
WHATSAPP_SELF_CHAT=false
WHATSAPP_ADMIN_EMAILS=

# Billing (optional): Razorpay webhook URL is https://<DOMAIN>/api/billing/webhook
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
BILLING_ENABLED=false

# Small server: keep per-user limits modest.
RATE_LIMIT_PER_MINUTE=300
CHAT_RATE_LIMIT_PER_MINUTE=20
SCHEDULER_ENABLED=true
